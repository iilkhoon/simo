NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:8080
DATABASE_URL=postgresql://simo:simo@localhost:5432/simo
JWT_SECRET=change-me-to-a-long-random-string
UPLOAD_DIR=./uploads
# true: OTP kodu cavabda qaytarılır və test ödənişi aktivdir. İSTEHSALDA false!
DEV_MODE=true
# İnkişafda bu e-poçtla qeydiyyat avtomatik admin olur. İSTEHSALDA işləmir — admin: npm run admin -- grant <email>
ADMIN_EMAILS=admin@technomania.az

# ───── İstehsal / təhlükəsizlik (bax docs/PRODUCTION.md) ─────
# NODE_ENV=production olduqda server DEV_MODE, test nömrələri, zəif JWT_SECRET ilə BAŞLAMIR.
# Şüurlu test mərhələsi (staging) üçün: SIMO_STAGING=true (real istifadəçilərdən əvvəl silin!)
# SIMO_STAGING=
# Dinləmə ünvanı (VPS: 127.0.0.1 — yalnız Caddy vasitəsilə) və etibarlı proksi (real IP üçün)
HOST=0.0.0.0
TRUST_PROXY=loopback
# Brauzerdən API-yə icazəli mənbələr (vergüllə). Boş: istehsalda yalnız WEB_URL
# CORS_ORIGINS=
# Şəxsi fayllar (KYC sənədləri) — ictimai /files/ altında DEYİL
# PRIVATE_UPLOAD_DIR=
# SAFETY_EVIDENCE_DIR=
# İstifadəçi media linkləri üçün əlavə icazəli hostlar (CDN), məs. cdn.simo.az
# MEDIA_HOSTS=
# SMS / OTP qoruması: yalnız bu ölkə prefiksləri, nömrə və sistem üzrə limitlər
OTP_ALLOWED_PREFIXES=+994
OTP_PER_PHONE_HOUR=5
OTP_PER_PHONE_DAY=10
OTP_GLOBAL_HOUR=500
# Token müddətləri (saniyə)
ACCESS_TTL_SEC=86400
REFRESH_TTL_SEC=7776000
# Baza hovuzu
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=30000
# Log səviyyəsi: fatal|error|warn|info|debug
# LOG_LEVEL=
# İstəyə bağlı: Sentry (əlavə olaraq serverdə `npm i @sentry/node`)
# SENTRY_DSN=
# Apple sandbox (TestFlight) alışları hamıya coin yazsın? İstehsalda false (yalnız test/review hesabları)
APPLE_ALLOW_SANDBOX=false

# Agora (https://console.agora.io) — sesli/görüntülü zəng və canlı yayın
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# SMS provayder (LSIM, Azercell Business və s.)
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=Simo

# App Store Server API (App Store Connect → Users and Access → Integrations → In-App Purchase)
APPLE_BUNDLE_ID=az.simo.app
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Google Play (service account JSON, bir sətirdə)
GOOGLE_PACKAGE_NAME=az.simo.app
GOOGLE_SERVICE_ACCOUNT_JSON=

# Epoint.az — Huawei versiyası və veb yükləmə üçün kart ödənişi (AZN)
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
EPOINT_API_URL=https://epoint.az/api/1

# iOS VoIP push (CallKit): Apple Developer → Keys → APNs (.p8)
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=az.simo.app
APNS_PRODUCTION=false
