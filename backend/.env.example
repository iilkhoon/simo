NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:8080
DATABASE_URL=postgresql://simo:simo@localhost:5432/simo
JWT_SECRET=change-me-to-a-long-random-string
UPLOAD_DIR=./uploads
# true: OTP kodu cavabda qaytarılır və test ödənişi aktivdir. İSTEHSALDA false!
DEV_MODE=true
ADMIN_EMAILS=admin@technomania.az

# Agora (https://console.agora.io) — sesli/görüntülü zəng və canlı yayın
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# SMS provayder (LSIM, Azercell Business və s.)
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=Simo

# App Store Server API (App Store Connect → Users and Access → Integrations → In-App Purchase)
APPLE_BUNDLE_ID=az.simo.app
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Google Play (service account JSON, bir sətirdə)
GOOGLE_PACKAGE_NAME=az.simo.app
GOOGLE_SERVICE_ACCOUNT_JSON=

# Epoint.az — Huawei versiyası və veb yükləmə üçün kart ödənişi (AZN)
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
EPOINT_API_URL=https://epoint.az/api/1

# iOS VoIP push (CallKit): Apple Developer → Keys → APNs (.p8)
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=az.simo.app
APNS_PRODUCTION=false
