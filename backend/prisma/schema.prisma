// Simo — verilənlər bazası sxemi (PostgreSQL)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum LookingFor {
  RELATIONSHIP
  FRIENDSHIP
  CHAT
  MARRIAGE
}

enum Role {
  USER
  ADMIN
}

enum HostStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum NobleTier {
  NONE
  BEY
  XAN
  SAH
}

enum VipTier {
  NONE
  SILVER
  GOLD
  DIAMOND
}

model User {
  id                 String     @id @default(cuid())
  shortId            Int        @unique @default(autoincrement())
  phone              String?    @unique
  email              String?    @unique
  passwordHash       String?
  name               String     @default("")
  gender             Gender?
  birthDate          DateTime?
  bio                String     @default("")
  city               String     @default("")
  avatarUrl          String?
  interests          String[]   @default([])
  languages          String[]   @default([])
  lookingFor         LookingFor @default(RELATIONSHIP)
  interestedIn       Gender?
  ageMin             Int        @default(18)
  ageMax             Int        @default(45)
  maxDistanceKm      Int        @default(100)
  lat                Float?
  lng                Float?
  locationAt         DateTime?
  onboarded          Boolean    @default(false)
  role               Role       @default(USER)
  hostStatus         HostStatus @default(NONE)
  verified           Boolean    @default(false)
  verificationUrl    String?
  coins              Int        @default(0)
  /// coins-in promo (pulsuz) hissəsi: bonuslardan gəlir, xərclənəndə qəbul edənə nağdlaşan almaz vermir
  promoCoins         Int        @default(0)
  diamonds           Int        @default(0)
  totalSpent         Int        @default(0)
  totalEarned        Int        @default(0)
  vipTier            VipTier    @default(NONE)
  vipUntil           DateTime?
  firstRechargeDone  Boolean    @default(false)
  /// Test hesabı: limitsiz promo Nar, reytinqdən kənar, alış demo (TEST_PHONES)
  isTester           Boolean    @default(false)
  /// 18+ və İstifadə Şərtləri (EULA) qəbul edildiyi an (qeydiyyat ekranındakı işarə)
  termsAcceptedAt    DateTime?
  videoCallPrice     Int        @default(80)
  voiceCallPrice     Int        @default(40)
  online             Boolean    @default(false)
  lastSeenAt         DateTime   @default(now())
  incognito          Boolean    @default(false)
  locale             String     @default("az")
  pushToken          String?
  /// Push tokeninin platforması: ios | android (zəng push-u üçün)
  pushPlatform       String?
  /// iOS PushKit VoIP tokeni — tətbiq bağlı olanda gələn zəng CallKit ekranında
  voipToken          String?
  agencyId           String?
  agencyJoinedAt     DateTime?
  referralCode       String     @unique @default(cuid())
  referredById       String?
  checkinStreak      Int        @default(0)
  lastCheckinAt      DateTime?
  freeMsgDate        String?
  freeMsgUsed        Int        @default(0)
  dailyLikesDate     String?
  dailyLikesUsed     Int        @default(0)
  dailySuperDate     String?
  dailySuperUsed     Int        @default(0)
  /// Hostun mesaj qiyməti (Nar). null — agentliyin standart qiyməti
  msgPrice           Int?
  /// Host "mənə yazmaq pulsuzdur" rejimi
  freeChat           Boolean    @default(false)
  /// Gündə pulsuz "salam" (yeni söhbətdə ilk mesaj) limiti
  helloDate          String?
  helloUsed          Int        @default(0)
  /// "Kimi göstərək" filtr dəyişikliyi — həftəlik limit
  filterWeek         String?
  filterUsed         Int        @default(0)
  kycStatus          KycStatus  @default(NONE)
  nobleTier          NobleTier  @default(NONE)
  nobleUntil         DateTime?
  /// Private content: aylıq abunə qiyməti (Nar). null — bağlıdır
  privatePrice       Int?
  /// Onboarding-in opsional cavabları: boy, təhsil, iş, vərdişlər, ünsiyyət üslubu, aktiv saatlar və s.
  profileExtra       Json       @default("{}")
  /// Zəng qəbulu: görüntülü / səsli ayrıca bağlana bilər
  acceptVideo        Boolean    @default(true)
  acceptVoice        Boolean    @default(true)
  /// Zəng saatları: {"from":"10:00","to":"23:00","days":[1,2,3,4,5,6,7]} (Bakı vaxtı). null — həmişə
  callHours          Json?
  /// Status: AUTO (onlayn/oflayn), ACTIVE (aktivəm), BUSY (məşğulam), AWAY (uzaqdayam)
  presence           String     @default("AUTO")
  /// Bildiriş üstünlükləri: {"messages":true,"follows":true,"visits":true,"offers":true,...}
  notifPrefs         Json       @default("{}")
  /// Ağıllı bildirişlər: gündəlik say (spam olmasın)
  smartPushDate      String?
  smartPushCount     Int        @default(0)
  /// Almaz balansının (diamonds) alınmış hissəsi: yalnız Almaz hədiyyələrinə xərclənir, nağdlaşmır
  diamondsBought     Int        @default(0)
  banned             Boolean    @default(false)
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  photos             Photo[]
  agency             Agency?    @relation("AgencyMembers", fields: [agencyId], references: [id])
  ownedAgency        Agency?    @relation("AgencyOwner")
  wallet             WalletTransaction[]
  payments           Payment[]
  videos             Video[]
  refreshTokens      RefreshToken[]
  notifications      Notification[]
  withdrawals        Withdrawal[]
  liveRooms          LiveRoom[]
  verifications      Verification[]
  stories            Story[]
  services           Service[]

  @@index([gender, onboarded, lastSeenAt])
  @@index([lat, lng])
  /// Agentlikdən könüllü çıxış anı — yeni agentliyə qoşulma üçün gözləmə müddəti (cooldown)
  agencyLeftAt       DateTime?
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SwipeAction {
  LIKE
  PASS
  SUPERLIKE
}

model Swipe {
  id        String      @id @default(cuid())
  fromId    String
  toId      String
  action    SwipeAction
  createdAt DateTime    @default(now())

  @@unique([fromId, toId])
  @@index([toId, action])
}

model Match {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
}

model Visit {
  id        String   @id @default(cuid())
  viewerId  String
  viewedId  String
  createdAt DateTime @default(now())

  @@unique([viewerId, viewedId])
  @@index([viewedId, createdAt])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetUserId String
  targetType   String       @default("USER")
  targetId     String?
  reason       String
  details      String       @default("")
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())

  @@index([status, createdAt])
}

model Conversation {
  id              String    @id @default(cuid())
  userAId         String
  userBId         String
  lastMessageAt   DateTime  @default(now())
  lastMessageText String    @default("")
  aLastReadAt     DateTime  @default(now())
  bLastReadAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  messages        Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

enum MessageType {
  TEXT
  IMAGE
  GIFT
  CALL
  SYSTEM
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType  @default(TEXT)
  text           String       @default("")
  mediaUrl       String?
  giftId         String?
  coinsCost      Int          @default(0)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum GiftTier {
  SMALL
  BIG
  LUXURY
}

model Gift {
  id       String   @id
  nameAz   String
  nameRu   String
  nameEn   String
  price    Int
  tier     GiftTier @default(SMALL)
  category String   @default("popular")
  sort     Int      @default(0)
  active   Boolean  @default(true)
  /// COIN — Nar ilə; DIAMOND — yalnız Almaz ilə alınan lüks hədiyyələr (qiymət qəpik dəyərində)
  currency Currency @default(COIN)
}

model GiftTransaction {
  id         String   @id @default(cuid())
  giftId     String
  senderId   String
  receiverId String
  count      Int      @default(1)
  coins      Int
  diamonds   Int
  context    String
  contextId  String?
  createdAt  DateTime @default(now())

  @@index([receiverId, createdAt])
  @@index([context, contextId])
  @@index([senderId, createdAt])
}

enum Currency {
  COIN
  DIAMOND
}

model WalletTransaction {
  id           String   @id @default(cuid())
  userId       String
  currency     Currency
  amount       Int
  balanceAfter Int
  type         String
  refId        String?
  note         String   @default("")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CoinPackage {
  id              String  @id
  coins           Int
  bonusCoins      Int     @default(0)
  priceQepik      Int
  appleProductId  String  @unique
  googleProductId String  @unique
  popular         Boolean @default(false)
  sort            Int     @default(0)
  active          Boolean @default(true)
  /// COIN — Nar paketi; DIAMOND — Almaz paketi (coins sahəsi qəpik dəyəridir)
  currency        Currency @default(COIN)
}

enum PaymentProvider {
  APPLE
  GOOGLE
  EPOINT
  DEV
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id          String          @id @default(cuid())
  userId      String
  provider    PaymentProvider
  packageId   String
  amountQepik Int
  coins       Int
  status      PaymentStatus   @default(PENDING)
  externalId  String?
  raw         Json?
  source      String          @default("app")
  createdAt   DateTime        @default(now())
  paidAt      DateTime?
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId, createdAt])
}

enum CallType {
  VIDEO
  VOICE
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  REJECTED
  CANCELLED
}

model Call {
  id            String     @id @default(cuid())
  callerId      String
  calleeId      String
  type          CallType
  status        CallStatus @default(RINGING)
  pricePerMin   Int        @default(0)
  channel       String     @unique
  startedAt     DateTime?
  endedAt       DateTime?
  billedMinutes Int        @default(0)
  coinsSpent    Int        @default(0)
  endReason     String?
  createdAt     DateTime   @default(now())

  @@index([callerId, createdAt])
  @@index([calleeId, createdAt])
  @@index([status])
}

enum LiveType {
  VIDEO
  VOICE
}

enum LiveStatus {
  LIVE
  ENDED
}

model LiveRoom {
  id          String     @id @default(cuid())
  hostId      String
  type        LiveType
  title       String     @default("")
  coverUrl    String?
  channel     String     @unique
  status      LiveStatus @default(LIVE)
  viewerCount Int        @default(0)
  peakViewers Int        @default(0)
  giftsCoins  Int        @default(0)
  likes       Int        @default(0)
  seatCount   Int        @default(8)
  startedAt   DateTime   @default(now())
  endedAt     DateTime?
  host        User       @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([status, startedAt])
}

enum MediaType {
  VIDEO
  PHOTO
}

enum VideoStatus {
  ACTIVE
  REMOVED
  SCHEDULED
}

model Video {
  id            String      @id @default(cuid())
  userId        String
  url           String
  thumbnailUrl  String?
  mediaType     MediaType   @default(VIDEO)
  isPrivate     Boolean     @default(false)
  /// Xüsusi postun demosu: hamı bulanıq önizləməni görür, tam versiya abunəçilər üçün.
  /// false və isPrivate — post yalnız abunəçilərə görünür (lentdə çıxmır)
  teaser        Boolean     @default(false)
  /// Planlanmış paylaşım vaxtı (status SCHEDULED)
  scheduledAt   DateTime?
  location      String      @default("")
  commentsOff   Boolean     @default(false)
  /// Demo üçün serverdə bulanıqlaşdırılmış önizləmə (orijinal URL kilidli postda heç vaxt göndərilmir)
  previewUrl    String?
  durationSec   Int         @default(0)
  savesCount    Int         @default(0)
  sharesCount   Int         @default(0)
  caption       String      @default("")
  hashtags      String[]    @default([])
  views         Int         @default(0)
  likesCount    Int         @default(0)
  commentsCount Int         @default(0)
  giftsCoins    Int         @default(0)
  status        VideoStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments      VideoComment[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([hashtags], type: Gin)
}

model VideoLike {
  videoId   String
  userId    String
  createdAt DateTime @default(now())

  @@id([videoId, userId])
}

model VideoView {
  videoId   String
  userId    String
  createdAt DateTime @default(now())

  @@id([videoId, userId])
  @@index([userId])
}

model VideoComment {
  id        String   @id @default(cuid())
  videoId   String
  userId    String
  text      String
  createdAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
}

enum AgencyStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model Agency {
  id             String       @id @default(cuid())
  name           String
  code           String       @unique
  ownerId        String       @unique
  logoUrl        String?
  description    String       @default("")
  commissionRate Float        @default(0.1)
  totalDiamonds  Int          @default(0)
  status         AgencyStatus @default(PENDING)
  /// Müraciət formu
  city           String       @default("")
  contactPhone   String       @default("")
  contactName    String       @default("")
  experience     String       @default("")
  expectedHosts  Int          @default(0)
  /// Agentliyin hostları üçün standart mesaj qiyməti (Nar)
  defaultMsgPrice Int         @default(30)
  rejectReason   String       @default("")
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())
  owner          User         @relation("AgencyOwner", fields: [ownerId], references: [id])
  members        User[]       @relation("AgencyMembers")
  requests       AgencyJoinRequest[]
  /// Admin tərəfindən təyin olunmuş fərdi komissiya (dəyərin payı, 0..0.3). null — səviyyəyə görə avtomatik
  customShare    Float?
  earnings       HostEarning[]
  settlements    AgencySettlement[]
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AgencyJoinRequest {
  id        String        @id @default(cuid())
  agencyId  String
  userId    String
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  agency    Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, status])
  @@index([userId])
  /// CODE — dəvət kodu/linki ilə, APPLY — kataloqdan müraciət
  source       String    @default("APPLY")
  message      String    @default("")
  rejectReason String    @default("")
  decidedAt    DateTime?
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model Withdrawal {
  id          String           @id @default(cuid())
  userId      String
  diamonds    Int
  amountQepik Int
  method      String
  account     String
  status      WithdrawalStatus @default(PENDING)
  note        String           @default("")
  createdAt   DateTime         @default(now())
  processedAt DateTime?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  /// Xidmət haqqı (qəpik) və rədd səbəbi (istifadəçiyə görünür)
  feeQepik     Int       @default(0)
  rejectReason String    @default("")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  actorId   String?
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Verification {
  id          String    @id @default(cuid())
  userId      String
  firstName   String
  lastName    String
  birthDate   DateTime
  docType     String    @default("ID_CARD")
  docFrontUrl String
  docBackUrl  String?
  selfieUrl   String
  status      KycStatus @default(PENDING)
  note        String    @default("")
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model VideoSave {
  videoId   String
  userId    String
  createdAt DateTime @default(now())

  @@id([videoId, userId])
  @@index([userId, createdAt])
}

model Story {
  id        String    @id @default(cuid())
  userId    String
  mediaUrl  String
  mediaType MediaType @default(PHOTO)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, createdAt])
}

model StoryView {
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  @@id([storyId, userId])
}

model Subscription {
  id           String   @id @default(cuid())
  subscriberId String
  creatorId    String
  priceCoins   Int
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([subscriberId, creatorId])
  @@index([creatorId, expiresAt])
}

enum PkStatus {
  PENDING
  ACTIVE
  ENDED
  DECLINED
}

model PkBattle {
  id         String   @id @default(cuid())
  roomAId    String
  roomBId    String
  hostAId    String
  hostBId    String
  scoreA     Int      @default(0)
  scoreB     Int      @default(0)
  status     PkStatus @default(PENDING)
  durationSec Int     @default(300)
  startedAt  DateTime?
  endsAt     DateTime?
  winnerId   String?
  createdAt  DateTime @default(now())

  @@index([status])
}

model Raffle {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  prizeCoins  Int
  winners     Int       @default(1)
  endsAt      DateTime
  drawnAt     DateTime?
  winnerIds   String[]  @default([])
  createdAt   DateTime  @default(now())
  entries     RaffleEntry[]
}

model RaffleEntry {
  raffleId  String
  userId    String
  source    String   @default("APP")
  createdAt DateTime @default(now())
  raffle    Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@id([raffleId, userId])
}

/// Davranış hadisələri — alqoritm buradan öyrənir (baxılan ekranlar, profillər, postlar, axtarışlar)
model UserEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  targetId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

/// Hesablanmış zövq profili (keş): maraq çəkiləri, yaş/şəhər üstünlükləri, xərcləmə davranışı
model UserTaste {
  userId    String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

/// Fərdi təklif: paket bonusu, VIP endirimi və s. Ödənişdə avtomatik tətbiq olunur
model Offer {
  id          String    @id @default(cuid())
  userId      String
  kind        String
  packageId   String?
  bonusPct    Int       @default(0)
  discountPct Int       @default(0)
  data        Json?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, expiresAt])
}

enum ServiceKind {
  VIDEO_CALL
  VOICE_CALL
  CHAT
  CUSTOM
}

/// İstifadəçinin satdığı xidmət (məs. "30 dəq. ingilis dili danışığı", "fərdi video təbrik")
model Service {
  id          String      @id @default(cuid())
  userId      String
  kind        ServiceKind @default(CUSTOM)
  title       String
  description String      @default("")
  price       Int
  durationMin Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      ServiceOrder[]

  @@index([userId, active])
}

enum OrderStatus {
  PENDING
  ACCEPTED
  DONE
  CANCELLED
  DECLINED
}

/// Sifariş: Nar alıcıdan tutulur (escrow); satıcı "tamamlandı" deyəndə qazanc yazılır, imtinada geri qaytarılır
model ServiceOrder {
  id        String      @id @default(cuid())
  serviceId String
  buyerId   String
  sellerId  String
  price     Int
  paid      Int         @default(0)
  note      String      @default("")
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([sellerId, status])
  @@index([buyerId, createdAt])
}

/// Hər qazanc hadisəsi (ödənişli Nar xərclənəndə): host payı, agentlik komissiyası, mənbə.
/// Agentlik paneli, host qazanc bölgüsü, agentlik səviyyəsi və həftəlik hesabat bundan hesablanır.
model HostEarning {
  id           String   @id @default(cuid())
  hostId       String
  agencyId     String
  /// GIFT | CALL | MESSAGE | SUBSCRIPTION | SERVICE
  source       String
  paidCoins    Int
  hostAmount   Int
  agencyAmount Int
  refId        String?
  createdAt    DateTime @default(now())
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, createdAt])
  @@index([hostId, createdAt])
}

/// Hostun gündəlik aktivliyi (Bakı günü): onlayn saniyə — hədəflər və agentlik paneli üçün
model HostDailyStat {
  userId    String
  day       String
  onlineSec Int    @default(0)

  @@id([userId, day])
}

/// Agentliyin həftəlik hesabatı (bazar ertəsi açarı) — admin bağlayır, CSV ixrac olunur
model AgencySettlement {
  id           String   @id @default(cuid())
  agencyId     String
  week         String
  paidCoins    Int
  hostAmount   Int
  agencyAmount Int
  hosts        Int
  note         String   @default("")
  closedById   String?
  createdAt    DateTime @default(now())
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, week])
}
