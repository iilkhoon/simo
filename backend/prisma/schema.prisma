// Simo — verilənlər bazası sxemi (PostgreSQL)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum LookingFor {
  RELATIONSHIP
  FRIENDSHIP
  CHAT
  MARRIAGE
}

enum Role {
  USER
  ADMIN
}

enum HostStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum VipTier {
  NONE
  SILVER
  GOLD
  DIAMOND
}

model User {
  id                 String     @id @default(cuid())
  shortId            Int        @unique @default(autoincrement())
  phone              String?    @unique
  email              String?    @unique
  passwordHash       String?
  name               String     @default("")
  gender             Gender?
  birthDate          DateTime?
  bio                String     @default("")
  city               String     @default("")
  avatarUrl          String?
  interests          String[]   @default([])
  languages          String[]   @default([])
  lookingFor         LookingFor @default(RELATIONSHIP)
  interestedIn       Gender?
  ageMin             Int        @default(18)
  ageMax             Int        @default(45)
  maxDistanceKm      Int        @default(100)
  lat                Float?
  lng                Float?
  locationAt         DateTime?
  onboarded          Boolean    @default(false)
  role               Role       @default(USER)
  hostStatus         HostStatus @default(NONE)
  verified           Boolean    @default(false)
  verificationUrl    String?
  coins              Int        @default(0)
  diamonds           Int        @default(0)
  totalSpent         Int        @default(0)
  totalEarned        Int        @default(0)
  vipTier            VipTier    @default(NONE)
  vipUntil           DateTime?
  firstRechargeDone  Boolean    @default(false)
  videoCallPrice     Int        @default(60)
  voiceCallPrice     Int        @default(30)
  online             Boolean    @default(false)
  lastSeenAt         DateTime   @default(now())
  incognito          Boolean    @default(false)
  locale             String     @default("az")
  pushToken          String?
  agencyId           String?
  agencyJoinedAt     DateTime?
  referralCode       String     @unique @default(cuid())
  referredById       String?
  checkinStreak      Int        @default(0)
  lastCheckinAt      DateTime?
  freeMsgDate        String?
  freeMsgUsed        Int        @default(0)
  dailyLikesDate     String?
  dailyLikesUsed     Int        @default(0)
  dailySuperDate     String?
  dailySuperUsed     Int        @default(0)
  banned             Boolean    @default(false)
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  photos             Photo[]
  agency             Agency?    @relation("AgencyMembers", fields: [agencyId], references: [id])
  ownedAgency        Agency?    @relation("AgencyOwner")
  wallet             WalletTransaction[]
  payments           Payment[]
  videos             Video[]
  refreshTokens      RefreshToken[]
  notifications      Notification[]
  withdrawals        Withdrawal[]
  liveRooms          LiveRoom[]

  @@index([gender, onboarded, lastSeenAt])
  @@index([lat, lng])
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SwipeAction {
  LIKE
  PASS
  SUPERLIKE
}

model Swipe {
  id        String      @id @default(cuid())
  fromId    String
  toId      String
  action    SwipeAction
  createdAt DateTime    @default(now())

  @@unique([fromId, toId])
  @@index([toId, action])
}

model Match {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
}

model Visit {
  id        String   @id @default(cuid())
  viewerId  String
  viewedId  String
  createdAt DateTime @default(now())

  @@unique([viewerId, viewedId])
  @@index([viewedId, createdAt])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetUserId String
  targetType   String       @default("USER")
  targetId     String?
  reason       String
  details      String       @default("")
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())

  @@index([status, createdAt])
}

model Conversation {
  id              String    @id @default(cuid())
  userAId         String
  userBId         String
  lastMessageAt   DateTime  @default(now())
  lastMessageText String    @default("")
  aLastReadAt     DateTime  @default(now())
  bLastReadAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  messages        Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

enum MessageType {
  TEXT
  IMAGE
  GIFT
  CALL
  SYSTEM
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType  @default(TEXT)
  text           String       @default("")
  mediaUrl       String?
  giftId         String?
  coinsCost      Int          @default(0)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum GiftTier {
  SMALL
  BIG
  LUXURY
}

model Gift {
  id       String   @id
  nameAz   String
  nameRu   String
  nameEn   String
  price    Int
  tier     GiftTier @default(SMALL)
  category String   @default("popular")
  sort     Int      @default(0)
  active   Boolean  @default(true)
}

model GiftTransaction {
  id         String   @id @default(cuid())
  giftId     String
  senderId   String
  receiverId String
  count      Int      @default(1)
  coins      Int
  diamonds   Int
  context    String
  contextId  String?
  createdAt  DateTime @default(now())

  @@index([receiverId, createdAt])
  @@index([context, contextId])
  @@index([senderId, createdAt])
}

enum Currency {
  COIN
  DIAMOND
}

model WalletTransaction {
  id           String   @id @default(cuid())
  userId       String
  currency     Currency
  amount       Int
  balanceAfter Int
  type         String
  refId        String?
  note         String   @default("")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CoinPackage {
  id              String  @id
  coins           Int
  bonusCoins      Int     @default(0)
  priceQepik      Int
  appleProductId  String  @unique
  googleProductId String  @unique
  popular         Boolean @default(false)
  sort            Int     @default(0)
  active          Boolean @default(true)
}

enum PaymentProvider {
  APPLE
  GOOGLE
  EPOINT
  DEV
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id          String          @id @default(cuid())
  userId      String
  provider    PaymentProvider
  packageId   String
  amountQepik Int
  coins       Int
  status      PaymentStatus   @default(PENDING)
  externalId  String?
  raw         Json?
  source      String          @default("app")
  createdAt   DateTime        @default(now())
  paidAt      DateTime?
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId, createdAt])
}

enum CallType {
  VIDEO
  VOICE
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  REJECTED
  CANCELLED
}

model Call {
  id            String     @id @default(cuid())
  callerId      String
  calleeId      String
  type          CallType
  status        CallStatus @default(RINGING)
  pricePerMin   Int        @default(0)
  channel       String     @unique
  startedAt     DateTime?
  endedAt       DateTime?
  billedMinutes Int        @default(0)
  coinsSpent    Int        @default(0)
  endReason     String?
  createdAt     DateTime   @default(now())

  @@index([callerId, createdAt])
  @@index([calleeId, createdAt])
  @@index([status])
}

enum LiveType {
  VIDEO
  VOICE
}

enum LiveStatus {
  LIVE
  ENDED
}

model LiveRoom {
  id          String     @id @default(cuid())
  hostId      String
  type        LiveType
  title       String     @default("")
  coverUrl    String?
  channel     String     @unique
  status      LiveStatus @default(LIVE)
  viewerCount Int        @default(0)
  peakViewers Int        @default(0)
  giftsCoins  Int        @default(0)
  likes       Int        @default(0)
  startedAt   DateTime   @default(now())
  endedAt     DateTime?
  host        User       @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([status, startedAt])
}

enum VideoStatus {
  ACTIVE
  REMOVED
}

model Video {
  id            String      @id @default(cuid())
  userId        String
  url           String
  thumbnailUrl  String?
  caption       String      @default("")
  hashtags      String[]    @default([])
  views         Int         @default(0)
  likesCount    Int         @default(0)
  commentsCount Int         @default(0)
  giftsCoins    Int         @default(0)
  status        VideoStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments      VideoComment[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model VideoLike {
  videoId   String
  userId    String
  createdAt DateTime @default(now())

  @@id([videoId, userId])
}

model VideoView {
  videoId   String
  userId    String
  createdAt DateTime @default(now())

  @@id([videoId, userId])
  @@index([userId])
}

model VideoComment {
  id        String   @id @default(cuid())
  videoId   String
  userId    String
  text      String
  createdAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
}

enum AgencyStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model Agency {
  id             String       @id @default(cuid())
  name           String
  code           String       @unique
  ownerId        String       @unique
  logoUrl        String?
  description    String       @default("")
  commissionRate Float        @default(0.1)
  totalDiamonds  Int          @default(0)
  status         AgencyStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  owner          User         @relation("AgencyOwner", fields: [ownerId], references: [id])
  members        User[]       @relation("AgencyMembers")
  requests       AgencyJoinRequest[]
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AgencyJoinRequest {
  id        String        @id @default(cuid())
  agencyId  String
  userId    String
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  agency    Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, status])
  @@index([userId])
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model Withdrawal {
  id          String           @id @default(cuid())
  userId      String
  diamonds    Int
  amountQepik Int
  method      String
  account     String
  status      WithdrawalStatus @default(PENDING)
  note        String           @default("")
  createdAt   DateTime         @default(now())
  processedAt DateTime?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  actorId   String?
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
