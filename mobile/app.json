{
  "expo": {
    "name": "Simo",
    "slug": "simo",
    "scheme": "simo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F2EC",
    "primaryColor": "#F2344F",
    "description": "Simo — tanış ol, danış, sev. Görüntülü və səsli söhbət, canlı yayınlar, videolar.",
    "ios": {
      "bundleIdentifier": "az.simo.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "usesAppleSignIn": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Simo görüntülü zənglər, canlı yayınlar və profil şəkilləri üçün kameradan istifadə edir.",
        "NSMicrophoneUsageDescription": "Simo səsli və görüntülü zənglər, canlı yayınlar üçün mikrofondan istifadə edir.",
        "NSPhotoLibraryUsageDescription": "Profil şəkli və video paylaşmaq üçün qalereyaya giriş lazımdır.",
        "NSLocationWhenInUseUsageDescription": "Yaxınlığındakı insanları göstərmək üçün yerləşməndən istifadə edirik.",
        "UIBackgroundModes": [
          "audio",
          "remote-notification",
          "voip"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "az.simo.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2344F"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BIND_TELECOM_CONNECTION_SERVICE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.CALL_PHONE",
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.VIBRATE",
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.READ_PHONE_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F2EC"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#F7F2EC"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil şəkli və video paylaşmaq üçün qalereyaya giriş lazımdır.",
          "cameraPermission": "Selfi və profil şəkli üçün kamera lazımdır."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yaxınlığındakı insanları göstərmək üçün yerləşməndən istifadə edirik."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F2344F",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "@config-plugins/react-native-callkeep",
      [
        "./plugins/withVoipPush",
        {
          "enabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.simo.az",
      "webUrl": "https://simo.az",
      "eas": {
        "projectId": ""
      }
    }
  }
}